#!/usr/bin/env bash
# Debug build with Xcode.
# Usage:
#   ./scripts/build           # build
#   ./scripts/build --open    # build, then launch the app
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

OPEN_APP=false
for arg in "$@"; do
  case "$arg" in
    --open|-o) OPEN_APP=true ;;
    -h|--help)
      echo "Usage: $0 [--open|-o]"
      exit 0
      ;;
  esac
done

echo "==> Regenerating claude_* sprites (RGBA, transparent background)"

echo "==> xcodebuild (scheme DoggoAgent, Debug)"
xcodebuild \
  -project claude-pet.xcodeproj \
  -scheme DoggoAgent \
  -configuration Debug \
  clean build ONLY_ACTIVE_ARCH=YES \
  -derivedDataPath "$DERIVED" \
  -quiet

APP="$(ls -td "${DERIVED}/Build/Products/Debug/"*.app 2>/dev/null | head -n 1)"
echo "==> Build OK: $APP"
if $OPEN_APP; then
  echo "==> Opening app"
  open "$APP"
fi
